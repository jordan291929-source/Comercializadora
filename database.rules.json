{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "owner": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "usuarios": {
      ".read": "auth != null && root.child('usuarios/' + auth.uid + '/rol').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('usuarios/' + auth.uid + '/rol').val() === 'admin')",
        ".validate": "newData.hasChildren(['email', 'nombre'])",
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "creado": { ".validate": "newData.isString()" },
        "rol": { ".validate": "(newData.val() === 'admin' || newData.val() === 'ventas') && (root.child('usuarios/' + auth.uid + '/rol').val() === 'admin' || root.child('config/owner').val() === auth.uid)" },
        "$other": { ".validate": false }
      }
    },
    "seq": {
      "$name": {
        ".read": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists()",
        ".write": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists()",
        ".validate": "($name === 'pedidos' || $name === 'clientes') && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
      }
    },
    "clientes": {
      ".read": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists()",
      "$id": {
        ".write": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'code', 'created_at'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
        "code": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "created_at": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "document": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 25" },
        "address": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "district": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "$other": { ".validate": false }
      }
    },
    "productos": {
      ".read": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists()",
      "$id": {
        ".write": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'category', 'unit', 'sold_by_weight', 'price_cents', 'active'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "unit": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "sold_by_weight": { ".validate": "newData.isBoolean()" },
        "price_cents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "active": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "pedidos": {
      ".read": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists()",
      ".indexOn": ["created_at"],
      "$id": {
        ".write": "auth != null && root.child('usuarios/' + auth.uid + '/rol').exists() && newData.exists() && (!data.exists() || (data.child('status').val() !== 'Atendido' && data.child('status').val() !== 'Cancelado'))",
        ".validate": "newData.hasChildren(['code', 'client_id', 'client_name', 'product_id', 'product_name', 'created_by', 'created_at', 'status', 'weights', 'price_cents', 'weight_grams', 'total_cents']) && ((!data.exists() && newData.child('status').val() === 'Pendiente' && newData.child('created_by').val() === auth.uid) || (data.exists() && (newData.child('status').val() === data.child('status').val() || (data.child('status').val() === 'Pendiente' && (newData.child('status').val() === 'En preparación' || newData.child('status').val() === 'Cancelado')) || (data.child('status').val() === 'En preparación' && (newData.child('status').val() === 'Listo' || newData.child('status').val() === 'Cancelado')) || (data.child('status').val() === 'Listo' && (newData.child('status').val() === 'Atendido' || newData.child('status').val() === 'Cancelado'))))) && (newData.child('status').val() !== 'Atendido' || (newData.child('attended_at').isString() && newData.child('weight_grams').val() > 0))",
        "code": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "client_id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val()) && root.child('clientes/' + newData.val()).exists()" },
        "client_name": { ".validate": "newData.isString()" },
        "client_phone": { ".validate": "newData.isString()" },
        "product_id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "product_name": { ".validate": "newData.isString()" },
        "created_by": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "created_by_name": { ".validate": "newData.isString()" },
        "created_at": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "attended_at": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString()" },
        "sale_type": { ".validate": "newData.val() === 'Mayorista' || newData.val() === 'Minorista'" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "weights": { "$i": { ".validate": "newData.isString() && newData.val().length <= 12" } },
        "price_cents": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())" },
        "weight_grams": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "total_cents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    }
  }
}
